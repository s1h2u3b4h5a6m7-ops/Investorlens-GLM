{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://investorlens.dev/schemas/corporate_action.json",
  "title": "CorporateAction",
  "description": "A corporate action (split, bonus, dividend, merger, ...) affecting a security. Used to adjust historical prices.",
  "type": "object",
  "required": ["id", "security_id", "action_type", "ex_date", "provenance"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^ca_[a-f0-9]{12}$" },
    "security_id": { "type": "string" },
    "action_type": {
      "type": "string",
      "enum": ["split", "bonus", "rights", "dividend", "merger", "demerger", "symbol_change", "face_value_change", "listing", "delisting", "other"]
    },
    "ex_date": { "type": "string", "format": "date" },
    "record_date": { "type": ["string", "null"], "format": "date" },
    "announcement_date": { "type": ["string", "null"], "format": "date" },
    "ratio_numerator": { "type": ["number", "null"] },
    "ratio_denominator": { "type": ["number", "null"] },
    "amount_per_share": { "type": ["number", "string", "null"] },
    "new_symbol": { "type": ["string", "null"] },
    "new_face_value": { "type": ["number", "string", "null"] },
    "notes": { "type": ["string", "null"] },
    "provenance": { "$ref": "provenance.json" }
  }
}
