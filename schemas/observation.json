{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://investorlens.dev/schemas/observation.json",
  "title": "Observation",
  "description": "A single numeric/string fact at a point in time, with full provenance. The atomic unit of fact.",
  "type": "object",
  "required": ["id", "subject_id", "kind", "period", "as_of", "provenance"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^obs_[a-f0-9]{12}$" },
    "subject_id": { "type": "string" },
    "kind": {
      "type": "string",
      "enum": ["price_close", "price_close_adj", "price_open", "price_high", "price_low", "volume", "turnover",
               "market_cap", "revenue", "ebitda", "net_income", "eps", "debt", "raw_material_cost",
               "policy_rate", "cpi_yoy", "fx_rate", "other"]
    },
    "period": { "type": "string", "description": "e.g. '2024-09-30', 'FY2024', 'Q1-2025'" },
    "as_of": { "type": "string", "format": "date" },
    "value": { "type": ["number", "string", "null"] },
    "unit": { "type": ["string", "null"] },
    "currency": { "type": ["string", "null"] },
    "data_status": {
      "type": "string",
      "enum": ["observed", "estimated", "hypothesized", "unavailable"],
      "default": "observed"
    },
    "confidence": {
      "type": "string",
      "enum": ["high", "medium", "low", "estimated", "hypothesized"],
      "default": "medium"
    },
    "provenance": { "$ref": "provenance.json" }
  }
}
