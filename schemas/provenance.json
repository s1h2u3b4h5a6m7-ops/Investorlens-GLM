{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://investorlens.dev/schemas/provenance.json",
  "title": "Provenance",
  "description": "Metadata that makes a fact trustworthy. Attached to every important field in InvestorLens.",
  "type": "object",
  "required": ["source", "retrieved_at"],
  "additionalProperties": false,
  "properties": {
    "source": {
      "type": "string",
      "description": "Stable slug for the publisher/dataset (e.g. 'nse', 'bse', 'rbi_dbie').",
      "minLength": 1
    },
    "retrieved_at": {
      "type": "string",
      "format": "date-time",
      "description": "UTC ISO-8601 timestamp when the fact was fetched."
    },
    "source_url": { "type": "string", "format": "uri" },
    "document_id": { "type": "string" },
    "reporting_period": { "type": "string" },
    "page": { "type": "integer", "minimum": 1 },
    "section": { "type": "string" },
    "table": { "type": "string" },
    "extraction_method": {
      "type": "string",
      "enum": ["official_api", "bulk_download", "xlsx_parse", "pdf_parse", "html_scrape", "manual", "derived", "llm_extracted"]
    },
    "original_value": { "type": ["string", "number", "boolean", "null"] },
    "confidence": {
      "type": "string",
      "enum": ["high", "medium", "low", "estimated", "hypothesized"],
      "default": "medium"
    },
    "notes": { "type": ["string", "null"] }
  }
}
